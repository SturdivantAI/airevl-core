# airevl-core — environment variables
# Copy to .env.local for local development. Never commit a populated copy.
# Production values live in Vercel → Settings → Environment Variables.
# See SECURITY.md (Rule 1) for which variables are public and which are server-only.

# ── Public (compiled into the browser bundle; safe to expose) ──────────────────
NEXT_PUBLIC_SITE_URL=https://www.airevl.ai
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Server-only: Supabase ──────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Bypasses Row Level Security. Route handlers only, after verifying the caller.
SUPABASE_SERVICE_ROLE=

# ── Server-only: Upstash Redis (rate limits, audit and telemetry streams) ──────
# If unset, rate limiting falls back to per-instance memory and is NOT effective.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Server-only: Resend (certificate email) ────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM="AiRevl Academy <academy@airevl.ai>"
RESEND_REPLY_TO=contact@airevl.ai

# ── Server-only: model providers (src/lib/model-router) ────────────────────────
ANTHROPIC_API_KEY=
XAI_API_KEY=
