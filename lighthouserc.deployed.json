{
  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--headless --no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95,
            "aggregationMethod": "median"
          }
        ],
        "categories:performance": [
          "error",
          {
            "minScore": 0.5,
            "aggregationMethod": "median"
          }
        ],
        "categories:seo": [
          "warn",
          {
            "minScore": 0.9,
            "aggregationMethod": "median"
          }
        ],
        "categories:best-practices": [
          "warn",
          {
            "minScore": 0.9,
            "aggregationMethod": "median"
          }
        ]
      }
    }
  }
}
